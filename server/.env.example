# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres connection string, e.g. from Neon (https://neon.tech):
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=3000

# Where the frontend runs (allowed by CORS). Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Production only (render.yaml sets these on Render):
# NODE_ENV=production  -> secure cookies, and this server also serves the built app from dist/
# TRUST_PROXY=true     -> read the client IP from X-Forwarded-For (only behind a proxy you trust)
